RATE_LIMIT_FRONT_DESK=60
RATE_LIMIT_MANAGER=60
RATE_LIMIT_AUDITOR=30
FRONT_DESK_CREDIT_LIMIT=50
# Web demo (demo_app.py) only. Never commit the real key.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
MAX_QUESTIONS_PER_SESSION=20
RATE_LIMIT_PER_MINUTE=6
DAILY_QUESTION_CAP=300
DAILY_COST_CAP_USD=1.00
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.50
DEMO_VIDEO_URL=
