# The key the MCP client passes to this server. Make keys with: python scripts/make_keys.py (never commit them).
HOTEL_MCP_API_KEY=
# Optional (defaults shown in the README configuration table)
HOTEL_MCP_KEYS_FILE=.hotel-mcp/keys.json
HOTEL_MCP_RUNTIME_DIR=.hotel-mcp
